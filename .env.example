# ================================================================
# CYBERSAFE QUEST - ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================

# 1. Cấu hình Supabase Cloud (Database kịch bản, tiến độ người chơi & lịch sử tư vấn)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 2. Cấu hình Groq AI API (Trợ lý Chatbot phân tích ngữ cảnh sâu - Miễn phí tại https://console.groq.com/keys)
# Mô hình khuyên dùng: llama-3.3-70b-versatile (phân tích thông minh) hoặc llama-3.1-8b-instant (siêu tốc)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

